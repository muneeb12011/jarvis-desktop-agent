# ---------- who you are ----------
JARVIS_USER_NAME=
JARVIS_USER_TITLE=sir
# City for weather and the morning greeting
JARVIS_CITY=

# ---------- brain ----------
# Tried in order; if one is rate-limited or down the next takes over, even mid-conversation.
# Options: gemini, anthropic (or claude), openai, deepseek, groq, openrouter, ollama
# You can also set all of this from Settings > Brain inside Jarvis, no file editing needed.
LLM_PROVIDERS=gemini,ollama

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude. Key: https://console.anthropic.com/settings/keys (claude-haiku-5-5 is the faster, cheaper choice)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Groq, free tier: https://console.groq.com/keys. Pick a model that supports tool calling.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter, one key for many models (some free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# DeepSeek: https://platform.deepseek.com/api_keys. Keep deepseek-chat; the reasoning model can't use tools.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI, or any other OpenAI-compatible API (LM Studio, vLLM...). Optional.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION=true

# Local fallback. The text model MUST support tool calling (qwen2.5, llama3.1, qwen3).
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# ---------- behaviour ----------
# strict = approve every change | normal = approve risky actions | off = never ask
JARVIS_CONFIRM_LEVEL=normal
JARVIS_CONFIRM_TIMEOUT=60
JARVIS_MAX_STEPS=30

# ---------- voice ----------
# auto = local Whisper if installed (requirements-voice.txt), else Gemini
JARVIS_STT=auto
JARVIS_WHISPER_MODEL=base.en
JARVIS_TTS=true
JARVIS_TTS_VOICE=en-GB-RyanNeural
JARVIS_TTS_RATE=+8%

# ---------- security ----------
# Generate with: python generate_token.py  (must match frontend/.env)
JARVIS_AUTH_TOKEN=

LOG_LEVEL=INFO
