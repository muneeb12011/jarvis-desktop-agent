# ---------- who you are ----------
JARVIS_USER_NAME=
JARVIS_USER_TITLE=sir
# City for weather and the morning greeting
JARVIS_CITY=

# ---------- brain ----------
# Tried in order; if one is rate-limited or down the next takes over.
# Options: gemini, openai, ollama
LLM_PROVIDERS=gemini,ollama

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, LM Studio...). Optional.
# Groq example: OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile  OPENAI_VISION=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION=true

# Local fallback. The text model MUST support tool calling (qwen2.5, llama3.1, qwen3).
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# ---------- behaviour ----------
# strict = approve every change | normal = approve risky actions | off = never ask
JARVIS_CONFIRM_LEVEL=normal
JARVIS_CONFIRM_TIMEOUT=60
JARVIS_MAX_STEPS=30

# ---------- voice ----------
# auto = local Whisper if installed (requirements-voice.txt), else Gemini
JARVIS_STT=auto
JARVIS_WHISPER_MODEL=base.en
JARVIS_TTS=true
JARVIS_TTS_VOICE=en-GB-RyanNeural
JARVIS_TTS_RATE=+8%

# ---------- security ----------
# Generate with: python generate_token.py  (must match frontend/.env)
JARVIS_AUTH_TOKEN=

LOG_LEVEL=INFO
